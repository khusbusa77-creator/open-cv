import cv2

cap = cv2.VideoCapture(0)

while True:
    ret, frame = cap.read()

    frame = cv2.flip(frame, 1)

    h, w = frame.shape[:2]

    small = cv2.resize(frame, (w//2, h//2))

    gray = cv2.cvtColor(small, cv2.COLOR_BGR2GRAY)

    cv2.imshow("Gray", gray)

    if cv2.waitKey(1)==27:
        break

cap.release()
cv2.destroyAllWindows()
