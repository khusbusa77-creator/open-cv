import cv2

cap = cv2.VideoCapture(0)

k = 5

while True:
    ret, frame = cap.read()

    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

    blur = cv2.GaussianBlur(gray, (k,k), 0)

    edges = cv2.Canny(blur, 50, 150)

    cv2.imshow("Edges", edges)

    key = cv2.waitKey(1)

    if key == ord('w'):
        k += 2

    elif key == ord('s'):
        if k > 3:
            k -= 2

    elif key == 27:
        break

cap.release()
cv2.destroyAllWindows()
